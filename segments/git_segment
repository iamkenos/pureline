#!/usr/bin/env bash

# git_segment

# Set default symbols if not already defined in config
# Defaults should be standard symbols.
[[ -z ${PL_SYMBOLS[git_branch]} ]] && PL_SYMBOLS[git_branch]="╬" 
[[ -z ${PL_SYMBOLS[git_untracked]} ]] && PL_SYMBOLS[git_untracked]="?"
[[ -z ${PL_SYMBOLS[git_stash]} ]] && PL_SYMBOLS[git_stash]="§"
[[ -z ${PL_SYMBOLS[git_ahead]} ]] && PL_SYMBOLS[git_ahead]="↑"
[[ -z ${PL_SYMBOLS[git_behind]} ]] && PL_SYMBOLS[git_behind]="↓"
[[ -z ${PL_SYMBOLS[git_modified]} ]] && PL_SYMBOLS[git_modified]="+"
[[ -z ${PL_SYMBOLS[git_staged]} ]] && PL_SYMBOLS[git_staged]="•"
[[ -z ${PL_SYMBOLS[git_conflicts]} ]] && PL_SYMBOLS[git_conflicts]="*"

# -----------------------------------------------------------------------------
# append to prompt: git branch with indicators for;
#     number of; modified files, staged files and conflicts
# arg: $1 background color
# arg: $2 foreground color
# option variables;
#   PL_GIT_STASH: true/false
#   PL_GIT_AHEAD: true/false
#   PL_GIT_STAGED: true/false
#   PL_GIT_CONFLICTS: true/false
#   PL_GIT_MODIFIED: true/false
#   PL_GIT_UNTRACKED: true/false
function git_segment {
    which git >/dev/null 2>&1 || return ## return if no git

    local git_info
    git_info="$(git status --porcelain=2 --branch 2>/dev/null)" || return

    local git_branch
    git_branch="$(sed -n 's/^# branch.head //p' <<< "$git_info")"
    [[ -z "$git_branch" || "$git_branch" == "(detached)" ]] && return

    local git_head
    git_head="$(git rev-parse --short HEAD 2>/dev/null)"
    [[ -n "$git_head" ]] && git_branch="$git_branch ($git_head)"

    local bg_color="$1"
    local fg_color="$2"
    local content="${PL_SYMBOLS[git_branch]} $git_branch"

    if [ "$PL_GIT_AHEAD" = true ]; then
        local ab
        ab="$(sed -n 's/^# branch.ab \([0-9]*\) \([0-9]*\)/\1 \2/p' <<< "$git_info")"
        if [[ -n "$ab" ]]; then
            local ahead behind
            read ahead behind <<< "$ab"
            (( ahead > 0 )) && content+=" ${PL_SYMBOLS[git_ahead]}$ahead"
            (( behind > 0 )) && content+=" ${PL_SYMBOLS[git_behind]}$behind"
        fi
    fi

    # Stash (still needs separate call if enabled)
    if [ "$PL_GIT_STASH" = true ]; then
        local number_stash
        number_stash="$(git stash list 2>/dev/null | wc -l | tr -d '[:space:]')"
        (( number_stash > 0 )) && content+=" ${PL_SYMBOLS[git_stash]}$number_stash"
    fi

    if [ "$PL_GIT_STAGED" = true ]; then
        local staged
        staged=$(grep -cE '^[12] ' <<< "$git_info")
        (( staged > 0 )) && content+=" ${PL_SYMBOLS[git_staged]}$staged"
    fi

    if [ "$PL_GIT_CONFLICTS" = true ]; then
        local conflicts
        conflicts=$(grep -c '^u' <<< "$git_info")
        (( conflicts > 0 )) && content+=" ${PL_SYMBOLS[git_conflicts]}$conflicts"
    fi

    if [ "$PL_GIT_MODIFIED" = true ]; then
        local modified
        modified=$(grep -c '^.M' <<< "$git_info")
        (( modified > 0 )) && content+=" ${PL_SYMBOLS[git_modified]}$modified"
    fi

    if [ "$PL_GIT_UNTRACKED" = true ]; then
        local untracked
        untracked=$(grep -c '^\?' <<< "$git_info")
        (( untracked > 0 )) && content+=" ${PL_SYMBOLS[git_untracked]}$untracked"
    fi

    if grep -qv '^#' <<< "$git_info"; then
        [[ -n "$PL_GIT_DIRTY_FG" ]] && fg_color="$PL_GIT_DIRTY_FG"
        [[ -n "$PL_GIT_DIRTY_BG" ]] && bg_color="$PL_GIT_DIRTY_BG"
    fi

    PS1+="$(segment_end "$fg_color" "$bg_color")"
    PS1+="$(segment_content "$fg_color" "$bg_color" " $content ")"
    __last_color="$bg_color"
}